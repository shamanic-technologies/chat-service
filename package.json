{
  "name": "chat-service",
  "version": "1.0.0",
  "description": "Multi-org AI chat service with Claude Sonnet 4.6, tool calling, and SSE streaming",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run generate:openapi",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.0",
    "postgres": "^3.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "nanoid": "^3.3.18",
    "path-to-regexp": "^0.1.13",
    "postcss": "^8.5.18",
    "proxy-addr": "^2.0.8",
    "rollup": "^4.59.0",
    "shell-quote": "^1.9.0",
    "source-map-js": "^1.2.2"
  }
}
